 #include "dxmt_mem_census.hpp"
 #include "log/log.hpp"
 #include "util_madeira_switch.hpp"
+#include "util_env.hpp"
 #include <chrono>
 
 namespace dxmt {
 
 MemCensus g_mem_census{};
+
+namespace {
+struct AllocSite {
+  std::atomic<const char *> site{nullptr};
+  std::atomic<uint64_t> n{0}, bytes{0};
+};
+constexpr int kAllocSites = 32;
+AllocSite g_alloc_sites[kAllocSites];
+std::atomic<int64_t> g_alloc_last_ns{0};
+
+bool
+alloc_stats_on() {
+  static const bool on = env::getEnvVar("DXMT_ALLOC_STATS") == "1";
+  return on;
+}
+} // namespace
+
+void
+alloc_stat(const char *site, uint64_t bytes) {
+  if (!alloc_stats_on())
+    return;
+  for (auto &s : g_alloc_sites) {
+    const char *cur = s.site.load(std::memory_order_relaxed);
+    if (!cur) {
+      const char *expect = nullptr;
+      if (!s.site.compare_exchange_strong(expect, site, std::memory_order_relaxed) && expect != site)
+        continue;
+      cur = site;
+    }
+    if (cur != site)
+      continue;
+    s.n.fetch_add(1, std::memory_order_relaxed);
+    s.bytes.fetch_add(bytes, std::memory_order_relaxed);
+    break;
+  }
+  int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                    std::chrono::steady_clock::now().time_since_epoch())
+                    .count();
+  int64_t last = g_alloc_last_ns.load(std::memory_order_relaxed);
+  if (last == 0) {
+    g_alloc_last_ns.compare_exchange_strong(last, now, std::memory_order_relaxed);
+    return;
+  }
+  if (now - last < 2000000000 || !g_alloc_last_ns.compare_exchange_strong(last, now, std::memory_order_relaxed))
+    return;
+  double secs = (now - last) / 1e9;
+  for (auto &s : g_alloc_sites) {
+    const char *name = s.site.load(std::memory_order_relaxed);
+    if (!name)
+      break;
+    uint64_t n = s.n.exchange(0, std::memory_order_relaxed), b = s.bytes.exchange(0, std::memory_order_relaxed);
+    if (n)
+      ERR("[alloc-rate] ", name, ": ", (uint64_t)(n / secs), " buffers/s, ", (uint64_t)(b / secs / 1024), " KB/s, avg ",
+          b / n, " B");
+  }
+}
