+/* win: DXMT_PRECISE_MATH selects which fast-math shortcuts shaders are compiled without:
+ * 1 both, 2 only the reassociation/contraction flags, 4 only Metal's fast math
+ * functions (log2, exp2, rsqrt, ...). Used to tell a fast-math difference from a bug. */
+inline int
+airconv_precise_math_mode() {
+  static int mode = -1;
+  if (mode < 0) {
+    const char *e = getenv("DXMT_PRECISE_MATH");
+    mode = e ? atoi(e) : 0;
+    if (mode == 1)
+      mode = 6;
+  }
+  return mode;
+}
+
+inline bool
+airconv_precise_flags() {
+  return (airconv_precise_math_mode() & 2) != 0;
+}
+
+inline bool
+airconv_precise_math() {
+  return (airconv_precise_math_mode() & 4) != 0;
+}
