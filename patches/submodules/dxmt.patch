+/* win: DXMT_SHADER_DUMP=<folder> writes every shader's DXBC to
+ * <Documents>/wine/drive_c/<folder>/<fnv64>.dxbc ("1" means "shaders"), for debugging a
+ * game's rendering. */
+static void
+win_dump_shader(const void *bytecode, size_t size) {
+  static int on = -1;
+  static char dir[1024];
+  if (on < 0) {
+    const char *flag = getenv("DXMT_SHADER_DUMP");
+    const char *docs = getenv("MADEIRA_DOCS_DIR");
+    char fallback[1024];
+    on = flag && flag[0] && strcmp(flag, "0") != 0 && !strchr(flag, '/') && !strstr(flag, "..");
+    if (on && !(docs && *docs)) {
+      const char *home = getenv("CFFIXED_USER_HOME");
+      snprintf(fallback, sizeof fallback, "%s/Documents", home ? home : "");
+      docs = fallback;
+    }
+    if (on) {
+      snprintf(dir, sizeof dir, "%s/wine/drive_c/%s", docs, strcmp(flag, "1") ? flag : "shaders");
+      mkdir(dir, 0755);
+      fprintf(stderr, "[win] dumping shaders to %s\n", dir);
+    }
+  }
+  if (!on || !bytecode || !size) return;
+  uint64_t hash = 0xcbf29ce484222325ull;
+  for (size_t i = 0; i < size; i++) hash = (hash ^ ((const uint8_t *)bytecode)[i]) * 0x100000001b3ull;
+  char path[1100];
+  snprintf(path, sizeof path, "%s/%016llx.dxbc", dir, (unsigned long long)hash);
+  if (access(path, F_OK) == 0) return;
+  FILE *f = fopen(path, "wb");
+  if (!f) return;
+  fwrite(bytecode, 1, size, f);
+  fclose(f);
+}
