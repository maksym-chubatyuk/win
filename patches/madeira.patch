diff --git a/build/ntdll-unix/virtual_ios.c b/build/ntdll-unix/virtual_ios.c
index 06cd0d1..961cea5 100644
--- a/build/ntdll-unix/virtual_ios.c
+++ b/build/ntdll-unix/virtual_ios.c
@@ -29541,8 +29541,98 @@ struct thread_stack_info
     char  *end;
     SIZE_T guaranteed;
     BOOL   is_wow;
+    ULONG_PTR wow_base;   /* B of the window the 32-bit stack values are relative to */
 };
 
+/* [wow-stack-grow] The WOW_TEB stack fields are GUEST addresses (thread_ios.c
+ * stores them with ios_wow_guest_addr), while fault addresses are HOST
+ * addresses, B + guest.  Comparing the two never matched, so a fault on the
+ * 32-bit stack's guard page was treated as "not a thread stack": the page was
+ * committed with STATUS_GUARD_PAGE_VIOLATION but Tib.StackLimit never moved,
+ * and once the SEH chain sat below the stale limit RtlUnwind/RtlDispatchException
+ * rejected it and the process died with STATUS_BAD_STACK.  B comes from the
+ * window the TEB lives in (it is in its own process's window), so this is also
+ * right on the Mach exception-server thread, which has no pseudo-process. */
+static ULONG_PTR ios_wow_stack_base_for_teb( TEB *teb )
+{
+#ifdef WINE_IOS
+    struct ios_wow_window *slot = ios_wow_live_slot_for_addr( teb );
+    return slot ? slot->base : 0;
+#else
+    return 0;
+#endif
+}
+
+static BOOL is_inside_wow_thread_stack( void *ptr, struct thread_stack_info *stack, TEB *teb )
+{
+    WOW_TEB *wow_teb = get_wow_teb( teb );
+    size_t min_guaranteed = max( page_size, host_page_size );
+    ULONG_PTR base;
+
+    if (!wow_teb || !wow_teb->DeallocationStack) return FALSE;
+    base = ios_wow_stack_base_for_teb( teb );
+    stack->wow_base = base;
+    stack->start = (char *)base + wow_teb->DeallocationStack;
+    stack->limit = (char *)base + wow_teb->Tib.StackLimit;
+    stack->end   = (char *)base + wow_teb->Tib.StackBase;
+    stack->guaranteed = max( wow_teb->GuaranteedStackBytes, min_guaranteed );
+    stack->is_wow = TRUE;
+    return ((char *)ptr > stack->start && (char *)ptr <= stack->end);
+}
+
+/* [wow-stack-ovf] once per session: what filled a 32-bit stack.  Prints the
+ * most frequent code-looking dwords over the whole stack (a recursion cycle or
+ * a per-call leak shows up as a few return addresses repeated thousands of
+ * times) and the words around the faulting address.  dprintf only: this can run
+ * on the Mach exception-server thread. */
+static void ios_wow_stack_overflow_report( const void *addr, const struct thread_stack_info *si )
+{
+    static int reported;
+    static ULONG vals[4096];
+    static unsigned int cnt[4096];
+    const ULONG *p, *lo, *hi;
+    unsigned int i, j, k;
+
+    if (reported++) return;
+    memset( vals, 0, sizeof(vals) );
+    memset( cnt, 0, sizeof(cnt) );
+    lo = (const ULONG *)(ROUND_ADDR( addr, host_page_mask ) + host_page_size);
+    hi = (const ULONG *)si->end;
+    dprintf( 2, "[wow-stack-ovf] 32-bit stack overflow: fault %p, B=%p, guest stack %08lx..%08lx, scanning %08lx..%08lx\n",
+             addr, (void *)si->wow_base, (unsigned long)(si->start - (char *)si->wow_base),
+             (unsigned long)(si->end - (char *)si->wow_base),
+             (unsigned long)((char *)lo - (char *)si->wow_base), (unsigned long)((char *)hi - (char *)si->wow_base) );
+    for (p = lo; p < hi; p++)
+    {
+        ULONG v = *p;
+        if (v < 0x401000 || v >= 0x80000000) continue;
+        k = (v * 2654435761u) >> 20;
+        for (j = 0; j < 4096; j++, k = (k + 1) & 4095)
+        {
+            if (!vals[k]) { vals[k] = v; cnt[k] = 1; break; }
+            if (vals[k] == v) { cnt[k]++; break; }
+        }
+    }
+    for (i = 0; i < 24; i++)
+    {
+        unsigned int best = 0, bi = 0;
+        for (j = 0; j < 4096; j++) if (cnt[j] > best) { best = cnt[j]; bi = j; }
+        if (best < 64) break;
+        dprintf( 2, "[wow-stack-ovf]   top %2u: %08x x%u\n", i, (unsigned)vals[bi], best );
+        cnt[bi] = 0;
+    }
+    for (i = 0; i < 64 && lo + i * 4 + 4 <= hi; i++)
+        dprintf( 2, "[wow-stack-ovf]   %08lx: %08x %08x %08x %08x\n",
+                 (unsigned long)((char *)(lo + i * 4) - (char *)si->wow_base),
+                 (unsigned)lo[i * 4], (unsigned)lo[i * 4 + 1], (unsigned)lo[i * 4 + 2], (unsigned)lo[i * 4 + 3] );
+}
+
+static void set_wow_stack_limit( TEB *teb, struct thread_stack_info *stack_info, char *page )
+{
+    WOW_TEB *wow_teb = get_wow_teb( teb );
+    if (wow_teb) wow_teb->Tib.StackLimit = (ULONG)((ULONG_PTR)page - stack_info->wow_base);
+}
+
